# ============================================
# Binance API 配置
# ============================================

# 模式: testnet 或 real
# testnet = Binance Spot Testnet（默认，安全测试）
# real    = Binance 真实现货（真金白银，谨慎使用）
TRADE_MODE=testnet

# Binance API Key
# Testnet 请到 https://testnet.binance.vision/ 注册获取
# Real    请到 https://www.binance.com/ 注册获取
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET=your_secret_here

# ============================================
# Telegram 通知配置
# ============================================

# 1. 在 Telegram 搜索 @BotFather 创建 Bot 获取 Token
# 2. 搜索 @userinfobot 获取你的 Chat ID
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================
# EMA 趋势指标
# ============================================

EMA_FAST_PERIOD=20
EMA_SLOW_PERIOD=50

# EMA 差值阈值（百分比），|EMA20-EMA50|/price < 此值判定为震荡
GRID_MODE_EMA_THRESHOLD=0.008

# ============================================
# ATR 波动率指标
# ============================================

ATR_PERIOD=14

# 网格步长 = ATR × 此系数
GRID_STEP_ATR_MULT=0.6

# 趋势入场步长 = ATR × 此系数
TREND_ENTRY_ATR_MULT=0.8

# ============================================
# 止盈参数
# ============================================

# 趋势模式分批止盈（逗号分隔百分比，如 "1,2,3" = +1%, +2%, +3%）
TAKE_PROFIT_LEVELS=1,2,3

# 网格模式止盈（百分比，如 0.5 = 0.5%）
GRID_TAKE_PROFIT_PCT=0.5

# ============================================
# K线周期
# ============================================

PRIMARY_TIMEFRAME=15m
SECONDARY_TIMEFRAME=1h

# ============================================
# 网格交易参数（BTC/USDT 现货）
# ============================================

# 网格价格区间
GRID_LOW_PRICE=80000
GRID_HIGH_PRICE=120000

# 网格数量
GRID_COUNT=10

# 每个网格的买入金额（USDT）
ORDER_AMOUNT_USDT=5

# 策略净持仓上限（BTC），约 200 RMB
MAX_POSITION_BTC=0.00035

# 最大同时挂单数量
MAX_OPEN_ORDERS=5

# 价格异常波动暂停阈值（百分比，例如 5 表示 5%）
PRICE_SURGE_THRESHOLD=5

# 交易循环间隔（秒）
LOOP_INTERVAL_SECONDS=30

# ============================================
# 风险控制参数
# ============================================

# 单笔最大仓位占比（相对总资产）
MAX_POSITION_PER_TRADE_PCT=0.02

# 最大总敞口
MAX_TOTAL_EXPOSURE_PCT=0.40

# 最低现金保留
MIN_CASH_RESERVE_PCT=0.60

# 回撤熔断阈值（超过此值停止新交易）
DRAWDOWN_LIMIT_PCT=0.06

# 同向连续交易上限（超过此值减仓 30%）
MAX_CONSECUTIVE_SAME_DIR=6
