[Unit]
Description=Quan - Binance Spot Grid Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 运行用户（请替换为你的实际用户名）
User=ubuntu
Group=ubuntu

# 工作目录（请替换为你的实际路径）
WorkingDirectory=/home/ubuntu/quan

# Python 路径（使用 venv）
ExecStart=/home/ubuntu/quan/venv/bin/python main.py

# 重启策略：异常退出后自动重启
Restart=always
RestartSec=30

# 标准输出和错误输出合并到 journald
StandardOutput=journal
StandardError=journal

# 环境变量
Environment=PYTHONUNBUFFERED=1

# 安全加固（可选）
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
